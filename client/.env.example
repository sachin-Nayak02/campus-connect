# CampusConnect Client Environment Variables
# Copy to .env.local for local development or configure in Vercel Dashboard -> Settings -> Environment Variables

# Backend API URL (must include /api/v1)
# For local development: http://localhost:5000/api/v1
# For production (e.g. deployed on Render/Railway): https://your-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Backend WebSocket / Server Root URL (for Socket.IO and media uploads)
# For local development: http://localhost:5000
# For production (e.g. deployed on Render/Railway): https://your-backend.onrender.com
VITE_SOCKET_URL=http://localhost:5000
