{
  "name": "campusconnect",
  "version": "1.0.0",
  "description": "CampusConnect - A College-Only Social Media Platform",
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "cd client && npm run build",
    "vercel-build": "cd server && npx prisma generate && cd ../client && npm install && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "keywords": ["campusconnect", "social-media", "college"],
